# Local development works without keys; the grocery provider is always sandbox.
TURSO_DATABASE_URL=file:supper.db
TURSO_AUTH_TOKEN=
APP_URL=http://localhost:3000

# REQUIRED for deployed/private access. Generate each with: openssl rand -hex 32
APP_PASSWORD=
AUTH_SECRET=

# Stripe TEST mode only. Live keys are deliberately rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional AI web search. Without it, recipes are retrieved from published sources.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Protects GET /api/jobs. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional LIVE product price reads (does not enable grocery checkout).
# Create a Kroger developer application with Products API / product.compact access.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Match the credentials issued by Kroger: production or certification.
KROGER_ENVIRONMENT=production
