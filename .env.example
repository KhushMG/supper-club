# Local development works without keys; the grocery provider is always sandbox.
TURSO_DATABASE_URL=file:supper.db
TURSO_AUTH_TOKEN=
APP_URL=http://localhost:3000

# REQUIRED for deployed/private access. Generate each with: openssl rand -hex 32
APP_PASSWORD=
AUTH_SECRET=

# Stripe TEST mode only. Live keys are deliberately rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional tool-calling AI agent. Weekly planning and ordering have separate approvals.
OPENAI_API_KEY=
# Models are fixed to gpt-6-luna in lib/ai-models.ts; no costly automatic escalation.

# Protects GET /api/jobs. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional LIVE product price reads (does not enable grocery checkout).
# Create a Kroger developer application with Products API / product.compact access.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Match the credentials issued by Kroger: production or certification.
KROGER_ENVIRONMENT=production

# Google sign-in for invited members of this private household.
# OAuth client type: Web application. Exact production callback:
# https://supper-club-umber.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated verified Google email addresses allowed into this household.
GOOGLE_ALLOWED_EMAILS=
# Optional additions without replacing the original access list.
GOOGLE_ADDITIONAL_ALLOWED_EMAILS=
